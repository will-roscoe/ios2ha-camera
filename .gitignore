# Local-only working material: specs, plans, handoffs, backlogs, session memory,
# deployment scratch. None of it is tracked, so ignore the directory rather than
# naming each subdirectory and having new ones show up as untracked. A repo-level
# CLAUDE.md is the one thing here that would belong in version control.
.claude/*
!.claude/CLAUDE.md
.remember/
.superpowers/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Docs build output, and the API pages autosummary generates from the source
docs/_build/
docs/api/generated/

# Test / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime output (stills, archives, logs) must never be committed
archive/
*.log
.claude/deploy/

# deploy.sh's local settings (host and paths); see deploy.env.example
deploy.env
