# Settings for deploy.sh. Copy to deploy.env (untracked) and fill in.
# Each line keeps a value already set in the environment, so IOS2HA_HOST=other ./deploy.sh still works.
: "${IOS2HA_HOST:=camera-host.lan}"            # ssh destination of the Docker host
: "${IOS2HA_SRC:=/srv/ios2ha-camera/src}"      # build context on the host; deploy.sh syncs the tree here
: "${IOS2HA_STACK:=/srv/mediastack}"           # directory on the host holding the compose file
