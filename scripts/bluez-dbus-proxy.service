[Unit]
Description=BlueZ-only D-Bus proxy for the ios2ha-camera container
Documentation=https://github.com/will-roscoe/ios2ha-camera
After=bluetooth.service dbus.service
Wants=bluetooth.service

[Service]
Type=simple
# Root because its client is root: xdg-dbus-proxy only passes through a client
# whose uid matches its own (a mismatched client's Hello gets no reply at all).
# The restriction is the filter, not the uid -- through this socket everything
# except org.bluez answers ServiceUnknown, systemd and login1 included.
ExecStart=/usr/bin/xdg-dbus-proxy unix:path=/run/dbus/system_bus_socket /run/bluez-proxy/bus --filter --talk=org.bluez
RuntimeDirectory=bluez-proxy
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
